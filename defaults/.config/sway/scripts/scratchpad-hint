#!/bin/sh
set -eu

choice=$(
  printf '%s\n' \
    'htop' \
    'whatsapp' \
    'keepass' \
    'todos (caldav-tui)' \
    'evolution' \
    'theme-mode-toggle' \
    'wallpaper-random' \
    'nightlight-toggle' \
    'bluetooth-toggle' \
    'caffeine-toggle' \
    'keyboard-backlight-toggle' \
    'network-toggle' \
    'osd-toggle' \
    'pomo-start-50' \
    'pomo-start-10' \
    'pomo-cancel' \
    'feishin' \
    '' \
    'journal' \
    'ranger' \
    'terminal' \
    'ncpamixer' \
    'qalculate' \
    'tickrs' \
    'notification-dnd-toggle' \
    'mic-mute' \
    'vpn-random' \
    'vpn-home' \
  | rofi -dmenu -i -p 'Scratchpad' \
    -theme-str 'window { width: 55%; location: center; anchor: center; } listview { lines: 8; } entry { padding: 8px; }'
)

[ -n "${choice:-}" ] || exit 0

ipc="noctalia msg"

case "$choice" in
  'journal') exec ~/.config/sway/scripts/sway_scratchpad journal ;;
  'ranger') exec ~/.config/sway/scripts/sway_scratchpad ranger ;;
  'terminal') exec ~/.config/sway/scripts/sway_scratchpad terminal ;;
  'ncpamixer') exec ~/.config/sway/scripts/sway_scratchpad ncpamixer ;;
  'qalculate') exec ~/.config/sway/scripts/sway_scratchpad qalculate ;;
  'tickrs') exec ~/.config/sway/scripts/sway_scratchpad tickrs ;;
  'htop') exec ~/.config/sway/scripts/sway_scratchpad htop ;;
  'whatsapp') exec ~/.config/sway/scripts/sway_scratchpad whatsapp ;;
  'keepass') exec ~/.config/sway/scripts/sway_scratchpad keepass ;;
  'todos (caldav-tui)') exec ~/.config/sway/scripts/sway_scratchpad caldav-tui ;;
  'evolution') exec ~/.config/sway/scripts/sway_scratchpad evolution ;;
  'theme-mode-toggle') exec $ipc theme-mode-toggle ;;
  'wallpaper-random') exec $ipc wallpaper-random ;;
  'nightlight-toggle') exec $ipc nightlight-toggle ;;
  'bluetooth-toggle') exec $ipc bluetooth-toggle ;;
  'caffeine-toggle') exec $ipc caffeine-toggle ;;
  'notification-dnd-toggle') exec $ipc notification-dnd-toggle ;;
  'mic-mute') exec $ipc mic-mute ;;
  'keyboard-backlight-toggle') exec $ipc keyboard-backlight-toggle ;;
  'network-toggle') exec $ipc network-toggle ;;
  'osd-toggle') exec $ipc osd-toggle ;;
  'feishin') exec ~/.config/sway/scripts/sway_scratchpad feishin ;;
  'vpn-random') exec ~/.local/bin/wireguard-vpn-random-toggle > /tmp/vpn.log 2>&1 ;;
  'vpn-home') exec sudo -A resolvconf -u && wg-quick up home ;;
  'pomo-start-50') exec $ipc plugin noctalia/timer:timer all start 50 ;;
  'pomo-start-10') exec $ipc plugin noctalia/timer:timer all start 10 ;;
  'pomo-cancel') exec $ipc plugin noctalia/timer:timer all cancel ;;
esac
